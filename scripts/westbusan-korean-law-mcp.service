[Unit]
Description=West Busan pinned Korean Law MCP service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=westbusan-law-mcp
Group=westbusan-law-mcp
EnvironmentFile=/etc/westbusan-tourism-ai/law-mcp.env
Environment=MCP_HTTP_HOST=127.0.0.1
Environment=ALLOW_QUERY_API_KEY=0
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/westbusan-korean-law-mcp/current/build/index.js --mode http --port 18082
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
