[Unit]
Description=Quota-aware West Busan transport OD catch-up
After=network-online.target data-westbusan.mount
Wants=network-online.target
RequiresMountsFor=/data/westbusan

[Service]
Type=oneshot
User=busan-ops
Group=busan-ops
WorkingDirectory=/opt/westbusan/app
Environment=PYTHONPATH=/opt/westbusan/app/src
EnvironmentFile=/etc/westbusan/westbusan.env
EnvironmentFile=/etc/westbusan/credentials.env
RuntimeDirectory=westbusan-transport-backfill
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock -n /run/westbusan-transport-backfill/backfill.lock /data/westbusan/venv/bin/python3 -m westbusan.operations.transport_backfill --root /opt/westbusan/app --start 2025-07-01 --end 2026-08-26
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=2G
MemoryMax=4G
MemorySwapMax=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/data/westbusan

[Install]
WantedBy=multi-user.target
